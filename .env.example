# Copy to .env (and `source .env` or use a loader) or just export these in your shell.
# Only set the one matching the provider you intend to use.

GLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides, equivalent to --provider/--model/--base-url/--api-key-env:
# UCODE_PROVIDER=glm
# UCODE_MODEL=glm-5.2
# UCODE_BASE_URL=https://api.z.ai/api/paas/v4
# UCODE_API_KEY_ENV=GLM_API_KEY
